---
// src/pages/company/[id]/offerings.astro
// ALL CODE IN THIS FENCE RUNS EXCLUSIVELY ON THE SERVER (NODE.JS)

import Layout from '../../../layouts/main.astro';
import { view, getOfferings } from '../../../service/company';
import { toPreview } from '../../../service/offering';

const { id } = Astro.params;
const companyId = parseInt(id as string, 10);

// We bypass SSL for the local .NET backend during SSR

// 1. Fetch data on the server using the unified service helper!
let company: any = null;
let initialItems: any[] = [];
try {
  company = await view(companyId);
  
  if (company && (company.offerings?.view === 2 || company.offerings?.view === 3)) {
    const queryOutput = await getOfferings(companyId, { index: 0, length: 12 });
    if (queryOutput && queryOutput.series && queryOutput.series.length > 0) {
      initialItems = await toPreview(queryOutput.series);
    }
  }
} catch (err) {
  console.error("Failed to fetch company offerings", err);
}

// 2. Compute SEO properties Server-Side
const title = company?.name 
  ? `${company.name} Offerings & Services | BizSort`
  : `Offerings | BizSort`;

const description = company?.text || `View the list of offerings and services provided by ${company?.name || 'this company'}.`;

// 3. Serialize the complex object into a string for the HTML attribute
const companyJson = JSON.stringify(company || null);
const initialItemsJson = JSON.stringify(initialItems);
---

<Layout title={title} description={description}>
  <div style="background: #111827; color: white; padding: 1rem 2rem; text-align: center;">
    🚀 Rendered with Astro (Zero React Wrappers) - Standalone Offerings Page
  </div>

  <company-offerings company={companyJson} initial-items={initialItemsJson}></company-offerings>

  <script>
    // Import the real component!
    import '../../../company/offerings.ts';
  </script>
</Layout>

