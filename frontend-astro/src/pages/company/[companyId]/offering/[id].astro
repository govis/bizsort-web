---
// src/pages/offering/[id].astro
// ALL CODE IN THIS FENCE RUNS EXCLUSIVELY ON THE SERVER (NODE.JS)

import Layout from '../../../../layouts/main.astro';
import { view as viewOffering } from '../../../../service/offering';
import { view as viewCompany } from '../../../../service/company';

const { companyId: companyIdStr, id } = Astro.params;
const offeringId = parseInt(id as string, 10);
const companyId = parseInt(companyIdStr as string, 10);

// We bypass SSL for the local .NET backend during SSR
process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';

// 1. Fetch data on the server using the unified service helper!
let offering: any = null;
let company: any = null;
try {
  offering = await viewOffering(offeringId, companyId);
  if (offering && offering.company?.id) {
    company = await viewCompany(offering.company.id);
  }
} catch (err: any) {
  console.error("Failed to fetch offering", err);
}

// 2. Compute SEO properties Server-Side
const title = offering?.title 
  ? `${offering.title} - ${offering.category?.name || 'Offering'} | BizSort (Astro)`
  : `${offering?.title || 'Offering'} | BizSort (Astro)`;

const description = offering?.text || undefined;

// 3. Serialize the complex object into a string for the HTML attribute
const offeringJson = JSON.stringify(offering || {});
const companyJson = JSON.stringify(company || {});
---

<Layout title={title} description={description}>
  <div style="background: #111827; color: white; padding: 1rem 2rem; text-align: center;">
     Rendered with Astro (Zero React Wrappers)
  </div>

  <company-offering offering={offeringJson}></company-offering>

  <script>
    import '../../../../company/offering.ts';
  </script>
</Layout>
