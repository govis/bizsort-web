---
// src/pages/offering/[id].astro
import { view as viewOffering } from '../../service/offering';

const { id } = Astro.params;
const offeringId = parseInt(id as string, 10);

process.env.NODE_TLS_REJECT_UNAUTHORIZED = '0';

let offering: any = null;
try {
  // Pass 0 for companyId to let the backend discover it
  offering = await viewOffering(offeringId, 0);
} catch (err: any) {
  console.error("Failed to fetch offering", err);
}

if (offering && offering.company?.id) {
  return Astro.redirect(`/company/${offering.company.id}/offering/${offeringId}`, 301);
}

return new Response(null, {
  status: 404,
  statusText: 'Not found'
});
---
